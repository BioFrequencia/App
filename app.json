{
  "expo": {
    "name": "BioFrequência",
    "slug": "biofrequencia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biofrequencia.app"
    },
    "android": {
      "package": "com.biofrequencia.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O BioFrequência usa o Face ID para confirmar sua identidade ao fazer o check-in de chegada."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "O BioFrequência usa o Face ID para proteger os dados de vínculo deste dispositivo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ece433e7-de7d-4ce3-92fd-a95336b4b213"
      },
      "apiBaseUrl": "http://10.0.2.2/BioFrequenciaApi/"
    }
  }
}
