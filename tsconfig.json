{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Mesma lista do expo/tsconfig.base (o "exclude" substitui, não soma) +
  // test/: os testes rodam direto no Node (npm test), que tem os próprios
  // tipos; o app React Native não tem @types/node.
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios", "test"]
}
